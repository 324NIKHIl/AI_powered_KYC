# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=kyc_verification

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Face Verification ─────────────────────────────────────────────────────────
# Cosine similarity of aligned ArcFace embeddings (DeepFace tuned value). Check genuine
# Aadhaar-vs-selfie scores in the "Face similarity=" log line before raising it.
FACE_SIMILARITY_THRESHOLD=0.32
FACE_MODEL=ArcFace

# ── Document Verification ─────────────────────────────────────────────────────
DOCUMENT_CONFIDENCE_THRESHOLD=0.60
REQUIRE_DOCUMENT_CONFIDENCE_FOR_APPROVAL=false

# ── Aadhaar Secure QR ─────────────────────────────────────────────────────────
# Folder with UIDAI public-key certificate(s) used to verify QR signatures
UIDAI_CERT_DIR=certs/uidai

# ══ Evidence-based document verification ══════════════════════════════════════
# SECURITY: these live ONLY in backend/.env (git-ignored). They are never sent to the React app,
# never logged, and never returned by any API. Leave a provider blank to run local-only checks —
# the system then reports VERIFICATION_UNAVAILABLE (it never claims "verified" without evidence).

# Each document kind has a provider slot. <KIND>_PROVIDER = none | generic | mock
#   generic : POSTs JSON to <KIND>_API_URL with "<AUTH_HEADER>: <AUTH_SCHEME> <API_KEY>"
#             (see backend/services/kyc/providers/generic_rest.py for the request/response contract;
#              a vendor with another contract needs only a small adapter subclass)
#   mock    : development only — results are flagged MOCK_VERIFICATION and can NEVER produce VERIFIED;
#             ignored when APP_ENV=production
# If unset, "generic" is used automatically when both URL and KEY are set, otherwise "none".
PAN_PROVIDER=
PAN_API_URL=
PAN_API_KEY=

PASSPORT_PROVIDER=
PASSPORT_API_URL=
PASSPORT_API_KEY=

DL_PROVIDER=
DL_API_URL=
DL_API_KEY=

CITIZENSHIP_PROVIDER=
CITIZENSHIP_API_URL=
CITIZENSHIP_API_KEY=

EDUCATION_PROVIDER=
EDUCATION_API_URL=
EDUCATION_API_KEY=

# Optional per-provider tuning (replace PAN with PASSPORT / DL / CITIZENSHIP / EDUCATION):
# PAN_API_AUTH_HEADER=Authorization   PAN_API_AUTH_SCHEME=Bearer
# PAN_API_TIMEOUT_S=10                PAN_API_RETRIES=1
# PAN_API_STATUS_KEY=status           PAN_API_VALID_VALUES=VALID,VERIFIED,SUCCESS
# PAN_API_NOT_FOUND_VALUES=INVALID,NOT_FOUND,FAILED
# PAN_API_NAME_KEY=name               PAN_API_DOB_KEY=dob

# ── Aadhaar Secure QR trust ───────────────────────────────────────────────────
# UIDAI production public-key certificate(s): a folder (UIDAI_CERT_DIR above) and/or one file.
AADHAAR_CERTIFICATE_PATH=

# ── Face match decision bands (cosine similarity, ArcFace) ───────────────────
# similarity >= FACE_SIMILARITY_THRESHOLD            → MATCH
# FACE_NO_MATCH_THRESHOLD <= similarity < threshold  → UNCERTAIN (manual review)
# similarity < FACE_NO_MATCH_THRESHOLD               → NO_MATCH
FACE_NO_MATCH_THRESHOLD=0.22

# ── Liveness / face-alteration heuristics (uncalibrated defaults — tune on your own data) ──
LIVENESS_ATTACK_THRESHOLD=0.65      # attack score >= this → liveness FAIL  (→ SUSPICIOUS)
LIVENESS_UNCERTAIN_THRESHOLD=0.40   # >= this → UNCERTAIN (→ manual review)
DEEPFAKE_HIGH_RISK_THRESHOLD=0.70   # >= this → SUSPICIOUS
DEEPFAKE_REVIEW_THRESHOLD=0.45      # >= this → manual review
TAMPER_SUSPICIOUS_THRESHOLD=0.80    # document tamper-heuristic score → SUSPICIOUS

# ── OCR ───────────────────────────────────────────────────────────────────────
# Add 'ne' to read Devanagari (e.g. Nepal citizenship certificates): OCR_LANGUAGES=en,ne
OCR_LANGUAGES=en
